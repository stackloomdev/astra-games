[Unit]
Description=Astra Games upstream catalogue mirror
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=astra-games
Group=astra-games
ExecStart=/usr/bin/python3 -u /opt/astra-games/current/deploy/catalog-mirror.py /opt/astra-games/current/lib/i18n.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
